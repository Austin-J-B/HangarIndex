# Optional: defaults to this project's corpus/FAA-Public starter folder.
CORPUS_DIR=

# Local LLM by default. Thorough (35B-A3B) is the default; Quick (4B) is opt-in and less reliable.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_QUICK_MODEL=qwen3.5:4b
OLLAMA_THOROUGH_MODEL=qwen3.5:35b-a3b
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=640
# Hybrid FTS + local vector ranking is on by default; pull the embedding model first.
HANGAR_EMBEDDINGS=1
# Set HANGAR_EMBEDDINGS=0 for FTS-only search.
# Optional per-request tuning; leave blank to let Ollama choose automatically.
# OLLAMA_NUM_GPU=
# OLLAMA_NUM_THREAD=
# Thorough is preloaded at server start; pull qwen3.5:35b-a3b before first use.
# Pull qwen3.5:4b before selecting the opt-in Quick mode.
# Optional smaller Quick model: set OLLAMA_QUICK_MODEL=llama3.2:3b.

# For an OpenAI-compatible hosted endpoint, set LLM_PROVIDER=openai and fill these.
# Retrieved document text will be sent to this endpoint for answer generation.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional indexing guard; files larger than this are skipped. Default is 120 MiB.
# MAX_FILE_BYTES=125829120

# Optional phone access on a private Tailscale network. Replace with this computer's assigned
# Tailscale IPv4 (100.64.0.0/10) and exact IP/MagicDNS Host values. A passphrase is required.
# HANGAR_BIND=100.x.y.z
# HANGAR_ACCESS_TOKEN=choose-a-long-random-passphrase
# HANGAR_ALLOWED_HOSTS=100.x.y.z,hangar-pc.your-tailnet.ts.net
